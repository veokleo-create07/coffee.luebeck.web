# Server-only Supabase connection. Never expose the service-role key to the browser.
NEXT_PUBLIC_SITE_URL=https://www.altstadtliebe.com
SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_SERVICE_ROLE_KEY=your-service-role-key

# Resend server-only email delivery. The from address must use a verified domain.
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=Altstadtliebe <reservierungen@altstadtliebe.com>
CRON_SECRET=replace-with-a-long-random-secret

# Server-only Web Push credentials. Never expose the private key to the browser.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:team@altstadtliebeluebeck.de
